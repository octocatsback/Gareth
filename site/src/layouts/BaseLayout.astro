---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mona\'s GitHub Info',
  description = 'A bright Astro website that highlights GitHub docs, blog stories, and changelog updates.',
} = Astro.props;

// Respect the configured `base` (e.g. /Gareth/ on GitHub Pages); a hard-coded
// absolute path would resolve outside the site and 404.
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
