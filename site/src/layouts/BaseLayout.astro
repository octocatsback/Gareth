---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mona\'s GitHub Info',
  description = 'A bright Astro website that highlights GitHub docs, blog stories, and changelog updates.',
} = Astro.props;

// Files in public/ are served under the configured `base`, so build their URLs
// from BASE_URL instead of hard-coding root-relative paths.
const withBase = (path) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;
const faviconHref = withBase('favicon.svg');
const gridGraphicHref = withBase('graphics/grid.svg');
---

<!doctype html>
<html lang="en" style={`--grid-graphic: url('${gridGraphicHref}')`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
