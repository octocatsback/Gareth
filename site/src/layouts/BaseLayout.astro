---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mona\'s GitHub Info',
  description = 'A bright Astro website that highlights GitHub docs, blog stories, and changelog updates.',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconHref = `${baseUrl}favicon.svg`;
const gridImage = `url('${baseUrl}graphics/grid.svg')`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body style={`--grid-image: ${gridImage}`}>
    <slot />
  </body>
</html>
